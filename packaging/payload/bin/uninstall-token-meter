#!/usr/bin/env bash
set -euo pipefail

LABEL="com.token-meter.menubar"
INSTALL_DIR="/Library/Application Support/Token Meter"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
ROOT_URL="http://127.0.0.1:8722/"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Run with sudo: sudo '$INSTALL_DIR/bin/uninstall-token-meter'" >&2
  exit 1
fi

CONSOLE_USER="$(stat -f %Su /dev/console 2>/dev/null || true)"
if [[ -n "$CONSOLE_USER" && "$CONSOLE_USER" != "root" && "$CONSOLE_USER" != "loginwindow" ]]; then
  CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
  CONSOLE_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
  if [[ -n "$CONSOLE_UID" && -n "$CONSOLE_HOME" ]]; then
    PLIST="$CONSOLE_HOME/Library/LaunchAgents/$LABEL.plist"
    launchctl bootout "gui/$CONSOLE_UID/$LABEL" >/dev/null 2>&1 || true
    launchctl bootout "gui/$CONSOLE_UID" "$PLIST" >/dev/null 2>&1 || true
    rm -f "$PLIST"
  fi
fi

body="$(curl -s --max-time 2 "$ROOT_URL" 2>/dev/null || true)"
if [[ "$body" == *"Token Meter"* || "$body" == *"page.html not found next to meter.py"* || "$body" == *"page.html is missing"* ]]; then
  pids="$(lsof -tiTCP:8722 -sTCP:LISTEN 2>/dev/null || true)"
  while IFS= read -r pid; do
    [[ -n "$pid" ]] || continue
    kill "$pid" 2>/dev/null || true
  done <<< "$pids"
fi

rm -rf "$INSTALL_DIR"
pkgutil --forget com.galileo-agent-labs.token-meter >/dev/null 2>&1 || true
echo "Token Meter removed."
