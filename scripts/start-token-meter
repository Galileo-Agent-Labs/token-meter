#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOT_URL="http://127.0.0.1:8722/"
HEALTH_URL="http://127.0.0.1:8722/health"
LOG="$ROOT/meter.log"

if [[ ! -f "$ROOT/page.html" ]]; then
  echo "Missing dashboard UI: $ROOT/page.html" >&2
  echo "Run from a full token-meter clone, or copy page.html next to meter.py." >&2
  exit 1
fi

page_body="$(curl -s --max-time 2 "$ROOT_URL" 2>/dev/null || true)"
if [[ "$page_body" == *"page.html not found next to meter.py"* || "$page_body" == *"page.html is missing"* ]]; then
  echo "A stale Token Meter server is already running without page.html." >&2
  echo "Stop the listener on port 8722, then rerun: $ROOT/scripts/start-token-meter" >&2
  echo "Find it with: lsof -nP -iTCP:8722 -sTCP:LISTEN" >&2
  echo "Then stop that PID with: kill <PID>" >&2
  exit 1
fi

if ! curl -fsS --max-time 2 "$HEALTH_URL" >/dev/null 2>&1; then
  nohup python3 "$ROOT/meter.py" >> "$LOG" 2>&1 &
  ready=0
  for _ in $(seq 1 40); do
    if curl -fsS --max-time 1 "$HEALTH_URL" >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.25
  done
  if [[ "$ready" -ne 1 ]]; then
    echo "Token Meter server did not become healthy at $HEALTH_URL" >&2
    if [[ -f "$LOG" ]]; then
      tail -n 20 "$LOG" >&2
    fi
    exit 1
  fi
fi

exec "$ROOT/scripts/run-menubar"
